# Optional logger factory inputs, read by packages/logger/src/create-logger-module.ts.
# Consumers pass these through their own protected runtime environment.
LOG_LEVEL=info
NODE_ENV=production

# Release preparation inputs; used only by scripts/prepare-release-plan.mjs.
# Supply task-owned absolute paths in CI; blank values do not activate release.
RELEASE_PLAN_DIR=
GITHUB_OUTPUT=
