{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "paths": {
      "@arcanada/eslint-config": ["./packages/eslint-config/src/index.ts"]
    }
  },
  "include": [
    "scripts/*.mjs",
    "tests/*.mjs",
    "tests/*.d.ts",
    "eslint.config.js",
    "vitest.config.ts"
  ]
}
