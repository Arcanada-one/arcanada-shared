{
  "name": "@arcanada/jev-decision-templates",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded structural inspection of versioned JEV decision templates and closed source-only state contracts.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcanada-one/arcanada-shared.git",
    "directory": "packages/jev-decision-templates"
  },
  "homepage": "https://github.com/Arcanada-one/arcanada-shared/tree/main/packages/jev-decision-templates#readme",
  "files": [
    "dist",
    "templates"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/state.ts --format esm --out-dir .manifest-stage --clean && node scripts/compile-manifest.mjs && tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@arcanada/access-contracts": "workspace:^",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
