{
  "name": "arcanada-shared",
  "version": "0.0.0-private",
  "private": true,
  "description": "Reusable cross-project modules for the Arcanada ecosystem — shared TypeScript packages published under the @arcanada scope.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Arcanada-one/arcanada-shared#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcanada-one/arcanada-shared.git"
  },
  "bugs": {
    "url": "https://github.com/Arcanada-one/arcanada-shared/issues"
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm test:workflow && pnpm -r test",
    "test:workflow": "node --test tests/*.test.mjs",
    "lint": "pnpm -r --if-present lint && prettier --check \"**/*.{ts,mjs,md,json,yml,yaml}\"",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,mjs,md,json,yml,yaml}\"",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
